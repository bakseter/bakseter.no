---
layout: layouts/base.njk
title: Blog
---
<section class="mx-auto mt-16 w-full max-w-3xl flex-1">
  <h1 class="text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-100 md:text-4xl">Blog</h1>
  <p class="mt-3 text-sm leading-7 text-stone-600 dark:text-stone-400 md:text-base">{{ description }}</p>

  {% set posts = collections.posts | latest %}
  {% if posts.length %}
    {% include "post-list.njk" %}
  {% else %}
    <p class="mt-8 text-sm text-stone-500">No posts yet.</p>
  {% endif %}
</section>
