<!doctype html>
<html lang="{{ lang | default('en') }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% if title %}{{ title }} - {% endif %}{{ site.title }}</title>
    <meta name="description" content="{% if lang == 'no' %}CV — {{ site.author }}{% else %}CV — {{ site.author }}{% endif %}" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <style>
      /* A4 sheet: 210mm × 297mm on screen, exact A4 when printed */
      ::selection {
        background: #bbf7d0;
        color: #14532d;
      }
      a:focus-visible {
        outline: 2px solid #16a34a;
        outline-offset: 2px;
        border-radius: 2px;
      }
      a:hover {
        text-underline-offset: 3px;
      }
      @page {
        size: A4;
        margin: 0;
      }

      .sheet {
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        padding: 16mm 18mm;
        background: #ffffff;
        color: #44403c;
        box-shadow:
          0 1px 2px rgb(0 0 0 / 0.05),
          0 12px 32px rgb(0 0 0 / 0.12);
      }

      @media (max-width: 820px) {
        .sheet {
          width: 100%;
          min-height: 0;
        }
      }

      @media print {
        html,
        body {
          background: #ffffff !important;
          margin: 0;
          padding: 0;
        }
        .no-print {
          display: none !important;
        }
        .sheet {
          width: 210mm;
          min-height: 0;
          margin: 0;
          padding: 7mm 18mm;
          box-shadow: none;
        }
        .page-break-avoid {
          break-inside: avoid;
        }
        * {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }
    </style>
  </head>

  <body class="bg-stone-200 text-stone-700">
    <main class="px-4 py-8 md:px-6 md:py-12 print:p-0">
      <div class="no-print mx-auto mb-5 flex w-full max-w-[210mm] items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/" class="text-sm text-stone-500 underline transition hover:text-stone-900">← bakseter.no</a>
          {% if 'cv-no' in page.url %}
            <a href="/cv/" class="rounded-md border border-stone-300 px-2 py-0.5 font-mono text-[11px] text-stone-500 transition hover:border-stone-900 hover:text-stone-900">EN</a>
          {% else %}
            <a href="/cv-no/" class="rounded-md border border-stone-300 px-2 py-0.5 font-mono text-[11px] text-stone-500 transition hover:border-stone-900 hover:text-stone-900">NO</a>
          {% endif %}
        </div>
        <button
          type="button"
          onclick="window.print()"
          class="rounded-md bg-stone-900 px-3.5 py-1.5 text-xs font-medium text-white shadow-sm transition hover:bg-stone-700"
        >
          {% if lang == 'no' %}⬇ Lagre som PDF{% else %}⬇ Save as PDF{% endif %}
        </button>
      </div>

      {{ content | safe }}
    </main>
  </body>
</html>
